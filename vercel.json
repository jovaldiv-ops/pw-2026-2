{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "public/dist/**",
        "views/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}

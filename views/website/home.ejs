<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechStore - Computadoras</title>

    <!-- Bootstrap 5 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand fw-bold" href="#">
            💻 TechStore
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Laptops</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">PC Gaming</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Accesorios</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Contacto</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Hero -->
<section class="bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <h1 class="display-4 fw-bold">
                    Encuentra tu computadora ideal
                </h1>

                <p class="lead">
                    Laptops, computadoras gaming y equipos profesionales
                    para todas tus necesidades.
                </p>

                <a href="#productos" class="btn btn-light btn-lg">
                    Ver computadoras
                </a>
            </div>

            <div class="col-lg-6 text-center mt-4 mt-lg-0">
                <div class="display-1">
                    🖥️
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Categorías -->
<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold">Categorías</h2>
            <p class="text-muted">
                Encuentra el equipo que necesitas
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card h-100 text-center shadow-sm">
                    <div class="card-body py-5">
                        <div class="display-3 mb-3">💻</div>
                        <h4 class="card-title">Laptops</h4>
                        <p class="card-text text-muted">
                            Equipos portátiles para trabajo y estudio.
                        </p>
                        <a href="#" class="btn btn-outline-primary">
                            Ver laptops
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 text-center shadow-sm">
                    <div class="card-body py-5">
                        <div class="display-3 mb-3">🎮</div>
                        <h4 class="card-title">PC Gaming</h4>
                        <p class="card-text text-muted">
                            Computadoras diseñadas para gaming.
                        </p>
                        <a href="#" class="btn btn-outline-primary">
                            Ver Gaming
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 text-center shadow-sm">
                    <div class="card-body py-5">
                        <div class="display-3 mb-3">⚙️</div>
                        <h4 class="card-title">Componentes</h4>
                        <p class="card-text text-muted">
                            Procesadores, RAM, SSD, tarjetas gráficas y más.
                        </p>
                        <a href="#" class="btn btn-outline-primary">
                            Ver componentes
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Productos -->
<section id="productos" class="bg-light py-5">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Productos destacados</h2>
                <p class="text-muted mb-0">
                    Los equipos más populares
                </p>
            </div>

            <a href="#" class="btn btn-primary">
                Ver todos
            </a>
        </div>

        <div class="row g-4">

            <!-- Producto 1 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">

                    <div class="text-center p-4 bg-white">
                        <div class="display-3">💻</div>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title">
                            Laptop Pro 15
                        </h5>

                        <p class="card-text text-muted">
                            Intel Core i7 · 16GB RAM · SSD 512GB
                        </p>

                        <h4 class="text-primary">
                            S/ 3,299
                        </h4>

                        <button class="btn btn-primary w-100">
                            Ver producto
                        </button>
                    </div>
                </div>
            </div>

            <!-- Producto 2 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">

                    <div class="text-center p-4 bg-white">
                        <div class="display-3">🖥️</div>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title">
                            PC Gaming X
                        </h5>

                        <p class="card-text text-muted">
                            Ryzen 7 · 32GB RAM · RTX 4070
                        </p>

                        <h4 class="text-primary">
                            S/ 5,499
                        </h4>

                        <button class="btn btn-primary w-100">
                            Ver producto
                        </button>
                    </div>
                </div>
            </div>

            <!-- Producto 3 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">

                    <div class="text-center p-4 bg-white">
                        <div class="display-3">💻</div>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title">
                            Laptop Student
                        </h5>

                        <p class="card-text text-muted">
                            Intel Core i5 · 8GB RAM · SSD 256GB
                        </p>

                        <h4 class="text-primary">
                            S/ 1,899
                        </h4>

                        <button class="btn btn-primary w-100">
                            Ver producto
                        </button>
                    </div>
                </div>
            </div>

            <!-- Producto 4 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">

                    <div class="text-center p-4 bg-white">
                        <div class="display-3">🖥️</div>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title">
                            PC Office
                        </h5>

                        <p class="card-text text-muted">
                            Core i5 · 16GB RAM · SSD 512GB
                        </p>

                        <h4 class="text-primary">
                            S/ 2,199
                        </h4>

                        <button class="btn btn-primary w-100">
                            Ver producto
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Banner -->
<section class="py-5">
    <div class="container">
        <div class="bg-dark text-white rounded-4 p-5 text-center">

            <h2 class="fw-bold">
                ¿No sabes qué computadora elegir?
            </h2>

            <p class="lead">
                Te ayudamos a encontrar el equipo adecuado para ti.
            </p>

            <a href="#" class="btn btn-primary btn-lg">
                Solicitar asesoría
            </a>

        </div>
    </div>
</section>

<!-- Footer -->
<footer class="bg-dark text-white py-4">
    <div class="container text-center">

        <h5>💻 TechStore</h5>

        <p class="text-secondary mb-2">
            Computadoras y tecnología para todos.
        </p>

        <small class="text-secondary">
            © 2026 TechStore. Todos los derechos reservados.
        </small>

    </div>
</footer>

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
